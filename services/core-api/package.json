{
  "name": "@aegisops/core-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/infrastructure/database/migrate.ts",
